# Legacy template: use --env-file .env to read this explicitly.
# The default user config template is .ossenv.example, copied to ~/.ossenv.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional, for temporary STS credentials only.
OSS_SESSION_TOKEN=

OSS_BUCKET=smell
OSS_REGION=cn-hangzhou
# Leave empty to use the region's default HTTPS endpoint.
# For a custom bucket domain, set its complete URL and OSS_USE_CNAME=true.
OSS_ENDPOINT=
OSS_USE_CNAME=false

OSS_WORKERS=4
OSS_PART_SIZE_MB=8
OSS_CONNECT_TIMEOUT=10
OSS_READ_TIMEOUT=60
OSS_MAX_ATTEMPTS=3
# Relative paths are resolved against this program's directory.
OSS_CHECKPOINT_DIR=.oss-checkpoints
